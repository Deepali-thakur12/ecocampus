# Copy this file to .env and fill in your Oracle connection details.
# Keep .env private; it is excluded by .gitignore.
ORACLE_USER=your_schema_username
ORACLE_PASSWORD=your_schema_password
# Examples: localhost:1521/FREEPDB1 or myhost.example.com:1521/ORCLPDB1
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
PORT=3000
